# ── Transcriber ─────────────────────────────────────────────────
# Copy this file to .env and adjust values to your setup.
# Priority: CLI args > env vars / .env > defaults shown below.

# HuggingFace token — required only for speaker diarization.
# Get a free Read token at https://huggingface.co/settings/tokens
# then accept terms at https://huggingface.co/pyannote/speaker-diarization-community-1
HF_TOKEN=

# Whisper model size (tiny | base | small | medium | large-v2 | large-v3)
MODEL=large-v3

# Compute device (cpu | cuda)
DEVICE=cuda

# Enable speaker diarization by default (true | false)
DIARIZE=false

# Root cache directory for models and data (default: <cwd>/.cache)
# CACHE_DIR=D:\models\cache

# ── Cache pre-download (trans-cache) ─────────────────────
# These only affect `trans-cache`. Inference always auto-detects language from the audio.

# Comma-separated language codes for alignment model download.
# Leave empty (or omit) to cache ALL available languages.
# LANGUAGE=en,pl,de,zh,es,fr,it,ja
